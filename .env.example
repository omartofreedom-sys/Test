# Copy to .env and fill in. Anything PUBLIC_* is exposed to the client at build time.

# MailerLite form identifiers. Extract these from the embed code MailerLite gives
# you for your form:
#   https://assets.mailerlite.com/jsonp/<ACCOUNT_ID>/forms/<FORM_ID>/subscribe
PUBLIC_MAILERLITE_ACCOUNT_ID=
PUBLIC_MAILERLITE_FORM_ID=

# Cloudflare Web Analytics beacon token. Leave blank in dev; the snippet only
# renders when this is set.
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
