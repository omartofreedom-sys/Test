# Copy to .env and fill in. Anything PUBLIC_* is exposed to the client at build time.

# MailerLite embedded form code. Find it in the MailerLite dashboard:
# Forms -> Embedded forms -> your form -> "Embed form" -> copy the value of
# `data-form` from the <div class="ml-embedded" data-form="XXXXXX"> snippet.
# The account ID is hardcoded in src/layouts/BaseLayout.astro (currently 2277770).
PUBLIC_MAILERLITE_FORM_CODE=

# Cloudflare Web Analytics beacon token. Leave blank in dev; the snippet only
# renders when this is set.
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
