---
import EmailCapture from './EmailCapture.astro';
import BookCard from './BookCard.astro';
import { leadMagnet } from '@/content/site';
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -left-24 top-10 h-72 w-72 rounded-full bg-taupe/20 blur-3xl"></div>
    <div class="absolute -right-16 bottom-0 h-80 w-80 rounded-full bg-oat/70 blur-3xl"></div>
  </div>

  <div class="container-wide grid items-center gap-12 py-16 sm:py-20 md:grid-cols-2 md:py-24">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full bg-oat px-3 py-1 text-xs font-medium uppercase tracking-wider text-cocoa">
        <span aria-hidden="true">*</span> Pre-launch
      </p>
      <h1 class="mt-5 font-display text-4xl font-semibold leading-tight text-ink sm:text-5xl md:text-6xl">
        Little words.<br />Big hearts.
      </h1>
      <p class="mt-5 max-w-prose text-lg text-ink/80">
        Warm, affirming board books for ages 0–3. Our first title,
        <em>Baby Affirmations</em>, is almost here — and we’d love you to read it first.
      </p>
      <div class="mt-8">
        <EmailCapture
          id="hero-capture"
          description={leadMagnet.promise}
        />
      </div>
    </div>

    <div class="md:justify-self-end">
      <BookCard showMeta={false} href={null} />
    </div>
  </div>
</section>
