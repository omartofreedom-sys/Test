---
interface Props {
  title: string;
  body: string;
  icon?: 'people' | 'brain' | 'moon';
}

const { title, body, icon } = Astro.props;
---

<article class="rounded-3xl bg-cream p-6 shadow-soft">
  {icon && (
    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-oat text-cocoa" aria-hidden="true">
      {icon === 'people' && (
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="8" r="3.25" />
          <circle cx="17" cy="10" r="2.5" />
          <path d="M3 19c.6-3.2 3.1-5 6-5s5.4 1.8 6 5" />
          <path d="M15 19c.4-2 1.9-3.2 4-3.2S22.6 17 23 19" />
        </svg>
      )}
      {icon === 'brain' && (
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5a3 3 0 0 0-3 3v.5A3.5 3.5 0 0 0 6 15a3 3 0 0 0 3 3h3V5Z" />
          <path d="M12 5a3 3 0 0 1 3 3v.5A3.5 3.5 0 0 1 18 15a3 3 0 0 1-3 3h-3" />
          <path d="M9 11h2M13 11h2M9 14h2M13 14h2" />
        </svg>
      )}
      {icon === 'moon' && (
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
          <circle cx="17" cy="7" r="0.8" fill="currentColor" />
          <circle cx="14" cy="4" r="0.6" fill="currentColor" />
        </svg>
      )}
    </div>
  )}
  <h3 class="mt-5 font-display text-xl font-semibold text-ink">{title}</h3>
  <p class="mt-3 text-ink/75">{body}</p>
</article>
