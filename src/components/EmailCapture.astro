---
import { leadMagnet } from '@/content/site';

interface Props {
  id?: string;
  heading?: string;
  description?: string;
  cta?: string;
  hint?: string;
  variant?: 'stacked' | 'inline';
}

const {
  id = 'email-capture',
  heading,
  description,
  cta = leadMagnet.cta,
  hint = leadMagnet.hint,
  variant = 'inline',
} = Astro.props;

const inputId = `${id}-email`;
const hintId = `${id}-hint`;
const statusId = `${id}-status`;
const consentId = `${id}-consent`;
const headingId = heading ? `${id}-heading` : undefined;

// MailerLite configuration \u2014 filled from the embed HTML paste.
// Replace both values from the MailerLite form embed you paste in.
const MAILERLITE_ACCOUNT_ID = import.meta.env.PUBLIC_MAILERLITE_ACCOUNT_ID ?? '';
const MAILERLITE_FORM_ID = import.meta.env.PUBLIC_MAILERLITE_FORM_ID ?? '';
const action = MAILERLITE_ACCOUNT_ID && MAILERLITE_FORM_ID
  ? `https://assets.mailerlite.com/jsonp/${MAILERLITE_ACCOUNT_ID}/forms/${MAILERLITE_FORM_ID}/subscribe`
  : '';
---

<form
  data-email-capture
  data-redirect="/thank-you"
  action={action}
  method="post"
  class="w-full max-w-xl"
  aria-labelledby={headingId}
  novalidate
>
  {heading && (
    <h2 id={headingId} class="font-display text-2xl font-semibold text-ink sm:text-3xl">
      {heading}
    </h2>
  )}
  {description && <p class="mt-3 text-ink/80">{description}</p>}

  <div
    class:list={[
      'mt-4 flex flex-col gap-3',
      variant === 'inline' ? 'sm:flex-row' : '',
    ]}
  >
    <label class="sr-only" for={inputId}>Email address</label>
    <input
      id={inputId}
      name="fields[email]"
      type="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      aria-describedby={`${hintId} ${statusId}`}
      class="input-base flex-1"
    />
    <button type="submit" class="btn-primary whitespace-nowrap" data-submit>
      <span data-label>{cta}</span>
      <span data-loading class="hidden">Sending\u2026</span>
    </button>
  </div>

  <div class="mt-3 flex items-start gap-2">
    <input
      id={consentId}
      name="consent"
      type="checkbox"
      required
      class="mt-1 h-4 w-4 rounded border-cocoa/40 text-cocoa focus:ring-cocoa"
    />
    <label for={consentId} class="text-sm text-ink/80">
      I agree to receive emails from Little Joy Books. See our
      <a class="font-medium text-cocoa underline-offset-4 hover:underline" href="/privacy">privacy policy</a>.
    </label>
  </div>

  {/* Honeypot \u2014 bots fill this in, humans don\u2019t see it. */}
  <div aria-hidden="true" class="absolute left-[-9999px] top-auto h-0 w-0 overflow-hidden" tabindex="-1">
    <label>Do not fill this out: <input type="text" name="b_website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <p id={hintId} class="mt-2 text-sm text-ink/80">{hint}</p>

  <p
    id={statusId}
    data-status
    role="status"
    aria-live="polite"
    class="mt-3 hidden text-sm"
  ></p>
</form>

<script>
  type CaptureForm = HTMLFormElement & { dataset: DOMStringMap };

  const forms = document.querySelectorAll<CaptureForm>('form[data-email-capture]');

  forms.forEach((form) => {
    const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
    const consentInput = form.querySelector<HTMLInputElement>('input[name="consent"]');
    const honeypot = form.querySelector<HTMLInputElement>('input[name="b_website"]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const label = submit?.querySelector<HTMLElement>('[data-label]');
    const loading = submit?.querySelector<HTMLElement>('[data-loading]');

    const setStatus = (kind: 'idle' | 'error' | 'success', message = '') => {
      if (!status) return;
      if (kind === 'idle') {
        status.className = 'mt-3 hidden text-sm';
        status.textContent = '';
        return;
      }
      status.textContent = message;
      status.className =
        kind === 'error'
          ? 'mt-3 rounded-xl border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800'
          : 'mt-3 rounded-xl border border-emerald-300 bg-emerald-50 px-3 py-2 text-sm text-emerald-800';
    };

    const setLoading = (isLoading: boolean) => {
      if (!submit || !label || !loading) return;
      submit.disabled = isLoading;
      submit.setAttribute('aria-busy', isLoading ? 'true' : 'false');
      label.classList.toggle('hidden', isLoading);
      loading.classList.toggle('hidden', !isLoading);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setStatus('idle');

      if (honeypot && honeypot.value.trim() !== '') {
        // Silently succeed for bots.
        window.location.assign(form.dataset.redirect ?? '/thank-you');
        return;
      }

      const email = emailInput?.value.trim() ?? '';
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setStatus('error', 'Please enter a valid email address.');
        emailInput?.focus();
        return;
      }

      if (!consentInput?.checked) {
        setStatus('error', 'Please tick the consent box so we can email you.');
        consentInput?.focus();
        return;
      }

      if (!form.action) {
        setStatus(
          'error',
          'Email signup isn\u2019t configured yet. Set PUBLIC_MAILERLITE_ACCOUNT_ID and PUBLIC_MAILERLITE_FORM_ID.',
        );
        return;
      }

      setLoading(true);
      try {
        const body = new FormData();
        body.append('fields[email]', email);
        body.append('ml-submit', '1');
        body.append('anticsrf', 'true');

        await fetch(form.action, {
          method: 'POST',
          body,
          mode: 'no-cors',
        });
        // MailerLite\u2019s jsonp endpoint returns opaque in no-cors mode.
        // We treat a network success as a signup success and redirect.
        window.location.assign(form.dataset.redirect ?? '/thank-you');
      } catch (err) {
        setLoading(false);
        setStatus('error', 'Something went wrong. Please try again in a moment.');
      }
    });
  });
</script>
