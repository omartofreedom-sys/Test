---
import { leadMagnet } from '@/content/site';

interface Props {
  id?: string;
  heading?: string;
  description?: string;
  cta?: string;
  hint?: string;
  variant?: 'stacked' | 'inline';
}

const {
  id = 'email-capture',
  heading,
  description,
  cta = leadMagnet.cta,
  hint = leadMagnet.hint,
  variant = 'inline',
} = Astro.props;

const inputId = `${id}-email`;
const hintId = `${id}-hint`;
const headingId = heading ? `${id}-heading` : undefined;
---

<form
  action="/thank-you"
  method="get"
  class="w-full max-w-xl"
  aria-labelledby={headingId}
  novalidate
>
  {heading && (
    <h2 id={headingId} class="font-display text-2xl font-semibold text-ink sm:text-3xl">
      {heading}
    </h2>
  )}
  {description && <p class="mt-3 text-ink/80">{description}</p>}

  <div
    class:list={[
      'mt-4 flex flex-col gap-3',
      variant === 'inline' ? 'sm:flex-row' : '',
    ]}
  >
    <label class="sr-only" for={inputId}>Email address</label>
    <input
      id={inputId}
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      aria-describedby={hintId}
      class="input-base flex-1"
    />
    <button type="submit" class="btn-primary whitespace-nowrap">
      {cta}
    </button>
  </div>
  <p id={hintId} class="mt-2 text-sm text-ink/60">{hint}</p>
</form>
