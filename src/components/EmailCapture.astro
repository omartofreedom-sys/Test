---
interface Props {
  id?: string;
  heading?: string;
  description?: string;
  formCode?: string;
}

const {
  id = 'email-capture',
  heading,
  description,
  formCode: formCodeProp,
} = Astro.props;

const formCode = formCodeProp ?? import.meta.env.PUBLIC_MAILERLITE_FORM_CODE ?? '';
const headingId = heading ? `${id}-heading` : undefined;
---

<section class="w-full max-w-xl" aria-labelledby={headingId}>
  {heading && (
    <h2 id={headingId} class="font-display text-2xl font-semibold text-ink sm:text-3xl">
      {heading}
    </h2>
  )}
  {description && <p class="mt-3 text-ink/80">{description}</p>}

  <div class:list={['ljb-mailerlite', heading || description ? 'mt-4' : '']}>
    {formCode ? (
      <div class="ml-embedded" data-form={formCode}></div>
    ) : (
      <p class="rounded-2xl border border-cocoa/20 bg-oat/60 p-4 text-sm text-ink/80">
        Email signup isn\u2019t configured yet. Set <code class="font-mono text-xs">PUBLIC_MAILERLITE_FORM_CODE</code> in your
        <code class="font-mono text-xs">.env</code> to the <code class="font-mono text-xs">data-form</code> value from your MailerLite embed snippet.
      </p>
    )}
  </div>
</section>
