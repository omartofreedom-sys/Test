---
const pillars = [
  {
    title: 'Warm, not saccharine',
    body: 'Words chosen with care \u2014 simple, sincere, and safe to say a thousand times at bedtime.',
  },
  {
    title: 'Made for small hands',
    body: 'Chunky board pages, rounded corners, and uncluttered art with plenty of space to breathe.',
  },
  {
    title: 'Quiet, inclusive joy',
    body: 'Stories that reflect every little reader and the grown-ups who love them.',
  },
];
---

<section class="bg-oat/50 py-16 sm:py-20" aria-labelledby="brand-heading">
  <div class="container-wide">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-cocoa">Our little promise</p>
      <h2 id="brand-heading" class="mt-3 font-display text-3xl font-semibold sm:text-4xl">
        Books that feel like a hand on the back of the head.
      </h2>
      <p class="mt-4 text-ink/80">
        Little Joy Books is a quiet imprint making gentle board books for the 0\u20133 shelf.
        Every title is built around one feeling: you are held.
      </p>
    </div>

    <ul class="mt-10 grid gap-6 md:grid-cols-3">
      {pillars.map((pillar) => (
        <li class="rounded-3xl bg-cream p-6 shadow-soft">
          <h3 class="font-display text-xl font-semibold text-ink">{pillar.title}</h3>
          <p class="mt-3 text-ink/75">{pillar.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
