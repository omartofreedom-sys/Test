---
import { site, nav } from '@/content/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';

// logo.png = the real brand wordmark (drop it into public/logo.png)
// Falls back to text if the file isn't there yet.
---

<header class="border-b border-oat/60 bg-cream/80 backdrop-blur">
  <div class="container-wide flex items-center justify-between py-4">
    <a href="/" aria-label={`${site.name} home`} class="focus-visible:outline-none">
      <img
        src="/logo.png"
        alt={site.name}
        width="152"
        height="48"
        class="h-10 w-auto [filter:brightness(0)]"
        onerror="this.style.display='none';this.nextElementSibling.style.display='inline';"
      />
      <span
        class="hidden font-display text-xl font-semibold text-ink"
        aria-hidden="true"
      >{site.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-1 sm:gap-2">
        {nav.map((item) => {
          const active = (item.href === '/' && current === '/') || (item.href !== '/' && current.startsWith(item.href));
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'rounded-full px-3 py-2 text-sm font-medium transition sm:px-4',
                  active ? 'bg-oat text-ink' : 'text-ink/80 hover:bg-oat/60 hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
