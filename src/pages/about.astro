---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmailCapture from '@/components/EmailCapture.astro';
import { site } from '@/content/site';
---

<BaseLayout
  title="About"
  description="The story behind Little Joy Books — a small imprint making warm, affirming board books for ages 0–3."
>
  <article class="container-prose py-16 sm:py-20">
    <header>
      <p class="text-sm font-semibold uppercase tracking-wider text-cocoa">About</p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">A quiet imprint with a simple aim.</h1>
    </header>

    <section class="mt-10" aria-labelledby="origin-heading">
      <h2 id="origin-heading" class="font-display text-2xl font-semibold text-ink">Our origin story</h2>
      <div class="mt-4 space-y-5 text-lg text-ink/85">
        <p>
          At Little Joy Books, we believe the stories children hear shape the voice
          inside their head.
        </p>
        <p>
          We make picture books that put positivity, confidence, and belonging into
          the hands of small readers — and into the everyday moments parents share
          with them. Bedtime. The car seat. The rug after breakfast.
        </p>
        <p>
          Books where every child sees themselves on the page. Books that leave a
          child a little lighter than they found them.
        </p>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="different-heading">
      <h2 id="different-heading" class="font-display text-2xl font-semibold text-ink">What makes us different</h2>
      <ul class="mt-4 space-y-4 text-ink/85">
        <li>
          <strong class="font-display text-ink">Diverse casts by default.</strong>
          Every book shows a range of skin tones, hair textures, families, and abilities — so every little reader sees themselves.
        </li>
        <li>
          <strong class="font-display text-ink">Research-informed words.</strong>
          We work with early-childhood educators to make sure our affirmations are developmentally right, not just cute.
        </li>
        <li>
          <strong class="font-display text-ink">Made to be held.</strong>
          Chunky board pages, rounded corners, generous white space. Designed for small hands and sleepy laps.
        </li>
      </ul>
    </section>

    <aside class="mt-12 rounded-3xl border border-cocoa/15 bg-oat/50 p-6 text-ink/85">
      <p>
        Little Joy Books is a sister imprint to
        <a class="font-semibold text-cocoa underline-offset-4 hover:underline" href={site.parentImprint.url}>
          {site.parentImprint.name}
        </a>,
        our first imprint making money-smart, wonder-filled books for older kids. Same studio, same soft heart — different shelf.
      </p>
    </aside>

    <div class="mt-12 rounded-4xl bg-oat/60 p-8">
      <EmailCapture id="about-capture" heading="Read it first." />
    </div>
  </article>
</BaseLayout>
