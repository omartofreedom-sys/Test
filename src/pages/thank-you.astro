---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thank you"
  description="You\u2019re on the Little Joy Books list. We\u2019ll be in touch soon."
  noindex
>
  <section class="container-prose py-24 text-center sm:py-32">
    <div aria-hidden="true" class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-oat">
      <svg viewBox="0 0 24 24" class="h-10 w-10 text-cocoa" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5" />
      </svg>
    </div>
    <h1 class="mt-6 font-display text-4xl font-semibold sm:text-5xl">You\u2019re on the list.</h1>
    <p class="mt-5 text-lg text-ink/80">
      Thank you for joining us at the very beginning. We\u2019ll send a gentle note when there\u2019s
      something lovely to share \u2014 a cover reveal, a spread, a release date.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/" class="btn-secondary">Back to home</a>
      <a href="/book/baby-affirmations" class="btn-primary">Peek at the book</a>
    </div>
  </section>
</BaseLayout>
