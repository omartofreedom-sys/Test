---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmailCapture from '@/components/EmailCapture.astro';
import { book } from '@/content/site';

const description = `${book.title} \u2014 ${book.subtitle} A ${book.format.toLowerCase()} for ages ${book.ages}.`;
---

<BaseLayout title={book.title} description={description} type="article">
  <article>
    <section class="container-wide grid items-center gap-12 py-16 sm:py-20 md:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-cocoa">The first book</p>
        <h1 class="mt-3 font-display text-4xl font-semibold leading-tight sm:text-5xl md:text-6xl">
          {book.title}
        </h1>
        <p class="mt-4 font-display text-xl text-ink/80">{book.subtitle}</p>

        <p class="mt-6 max-w-prose text-lg text-ink/80">{book.blurb}</p>

        <dl class="mt-8 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
          <div class="rounded-2xl bg-oat/60 p-3">
            <dt class="text-ink/60">Ages</dt>
            <dd class="font-display text-base text-ink">{book.ages}</dd>
          </div>
          <div class="rounded-2xl bg-oat/60 p-3">
            <dt class="text-ink/60">Format</dt>
            <dd class="font-display text-base text-ink">{book.format}</dd>
          </div>
          <div class="rounded-2xl bg-oat/60 p-3">
            <dt class="text-ink/60">Pages</dt>
            <dd class="font-display text-base text-ink">{book.pages}</dd>
          </div>
          <div class="rounded-2xl bg-oat/60 p-3">
            <dt class="text-ink/60">Release</dt>
            <dd class="font-display text-base text-ink">{book.releaseWindow}</dd>
          </div>
        </dl>
      </div>

      <div class="relative">
        <div class="mx-auto aspect-[4/5] w-full max-w-sm rotate-[2deg] rounded-4xl bg-gradient-to-br from-taupe/30 via-cream to-oat p-8 shadow-soft">
          <div class="flex h-full flex-col items-center justify-center rounded-3xl border border-cocoa/15 bg-cream/80 p-6 text-center">
            <p class="font-display text-xs uppercase tracking-[0.3em] text-cocoa">{book.title}</p>
            <p class="mt-6 font-display text-3xl font-semibold leading-snug text-ink">
              You are loved.<br />You are safe.<br />You are enough.
            </p>
            <p class="mt-8 text-sm text-ink/60">A first book of tiny, tender truths.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container-wide py-10 sm:py-16" aria-labelledby="spreads-heading">
      <h2 id="spreads-heading" class="font-display text-3xl font-semibold sm:text-4xl">From inside the book</h2>
      <p class="mt-3 max-w-prose text-ink/75">A few lines from the four-spread rhythm.</p>

      <ol class="mt-8 grid gap-4 sm:grid-cols-2">
        {book.spreads.map((spread, i) => (
          <li class="rounded-3xl border border-cocoa/10 bg-cream p-6 shadow-soft">
            <p class="text-xs font-medium uppercase tracking-wider text-stone">Spread {i + 1} \u2014 {spread.note}</p>
            <p class="mt-4 font-display text-2xl leading-snug text-ink">{spread.line}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="bg-oat/50 py-16 sm:py-20">
      <div class="container-prose text-center">
        <h2 class="font-display text-3xl font-semibold sm:text-4xl">Be the first to read it.</h2>
        <p class="mt-3 text-ink/80">Join the list and we\u2019ll send previews, cover reveals, and release news \u2014 nothing more.</p>
        <div class="mt-8 flex justify-center">
          <EmailCapture id="book-capture" />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
