---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookCard from '@/components/BookCard.astro';
import EmailCapture from '@/components/EmailCapture.astro';
import { book, leadMagnet } from '@/content/site';

const description = `${book.title} — ${book.subtitle} A ${book.format.toLowerCase()} for ages ${book.ages}, illustrated by ${book.illustrator}.`;
---

<BaseLayout title={book.title} description={description} type="article" image={book.cover}>
  <article>
    <section class="container-wide grid items-center gap-12 py-16 sm:py-20 md:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-cocoa">{book.status}</p>
        <h1 class="mt-3 font-display text-4xl font-semibold leading-tight sm:text-5xl md:text-6xl">
          {book.title}
        </h1>
        <p class="mt-4 font-display text-xl text-ink/80">{book.subtitle}</p>
        <p class="mt-3 text-ink/80">Illustrated by {book.illustrator}.</p>

        <p class="mt-6 max-w-prose text-lg text-ink/80">{book.blurb}</p>

        <dl class="mt-8 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
          <div class="rounded-2xl bg-oat/60 p-3">
            <dt class="text-ink/80">Ages</dt>
            <dd class="font-display text-base text-ink">{book.ages}</dd>
          </div>
          <div class="rounded-2xl bg-oat/60 p-3">
            <dt class="text-ink/80">Format</dt>
            <dd class="font-display text-base text-ink">{book.format}</dd>
          </div>
          <div class="rounded-2xl bg-oat/60 p-3">
            <dt class="text-ink/80">Pages</dt>
            <dd class="font-display text-base text-ink">{book.pages}</dd>
          </div>
          <div class="rounded-2xl bg-oat/60 p-3">
            <dt class="text-ink/80">Release</dt>
            <dd class="font-display text-base text-ink">{book.releaseWindow}</dd>
          </div>
        </dl>

        <a href="#pre-order" class="btn-primary mt-8">Notify me on launch day</a>
      </div>

      <div>
        <BookCard showMeta={false} href={null} />
      </div>
    </section>

    <section class="container-wide py-10 sm:py-16" aria-labelledby="whats-inside">
      <h2 id="whats-inside" class="font-display text-3xl font-semibold sm:text-4xl">What’s inside</h2>
      <p class="mt-3 max-w-prose text-ink/75">
        Ten tiny, tender truths. One per spread, read aloud in a voice your little one already trusts.
      </p>

      <ol class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {book.affirmations.map((line, i) => (
          <li class="flex items-start gap-4 rounded-2xl border border-cocoa/10 bg-cream p-4">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-oat font-display text-sm font-semibold text-cocoa" aria-hidden="true">
              {i + 1}
            </span>
            <p class="font-display text-lg leading-snug text-ink">{line}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="container-wide py-10 sm:py-16" aria-labelledby="sample-spreads">
      <h2 id="sample-spreads" class="font-display text-3xl font-semibold sm:text-4xl">Sample spreads</h2>
      <p class="mt-3 max-w-prose text-ink/75">A peek at three moments from the book.</p>

      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        {book.spreads.map((spread, i) => (
          <li class="rounded-3xl border border-cocoa/10 bg-cream p-6 shadow-soft">
            <p class="text-xs font-medium uppercase tracking-wider text-stone">Spread {i + 1} — {spread.note}</p>
            <p class="mt-4 font-display text-2xl leading-snug text-ink">{spread.line}</p>
            <p class="mt-3 text-sm text-ink/80">{spread.scene}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="pre-order" class="bg-oat/50 py-16 sm:py-20">
      <div class="container-prose text-center">
        <h2 class="font-display text-3xl font-semibold sm:text-4xl">Be the first to read it.</h2>
        <p class="mt-3 text-ink/80">
          Leave your email and we’ll send the free {leadMagnet.name} now, plus a gentle note the day the book goes live.
        </p>
        <div class="mt-8 flex justify-center">
          <EmailCapture id="book-capture" />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
