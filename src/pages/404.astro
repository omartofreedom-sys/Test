---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="We couldn\u2019t find that page. Let\u2019s get you back to something cozier."
  noindex
>
  <section class="container-prose py-20 text-center sm:py-28">
    <p class="font-display text-7xl font-semibold text-cocoa" aria-hidden="true">404</p>
    <h1 class="mt-4 font-display text-4xl font-semibold sm:text-5xl">This page wandered off.</h1>
    <p class="mt-5 text-lg text-ink/80">
      It happens to the best of us. Let\u2019s get you back to something cozier.
    </p>
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/book/baby-affirmations" class="btn-secondary">See the book</a>
    </div>
  </section>
</BaseLayout>
